{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/tool-manifest.schema.json",
  "title": "ToolHaven tool manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "tools"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "target": {
      "const": "x86_64-pc-windows-msvc"
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "status",
        "delivery",
        "sourceRepository",
        "licenseExpression",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "bundled",
            "downloadable"
          ]
        },
        "delivery": {
          "enum": [
            "embedded",
            "on-demand"
          ]
        },
        "sourceRepository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "licenseExpression": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*)+$"
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "bundled",
                  "downloadable"
                ]
              }
            }
          },
          "then": {
            "required": [
              "version",
              "artifacts"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "version"
                  ]
                },
                {
                  "required": [
                    "artifacts"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "bundlePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.?(?:[\\\\/]|$))(?!.*:).+$"
        },
        "binaryDirectory": {
          "type": "string",
          "description": "Directory inside the extracted archive that holds the executables. Empty when they sit at the root.",
          "pattern": "^(?!\\/)(?!.*\\.\\.)[^:]*$"
        }
      }
    }
  }
}
